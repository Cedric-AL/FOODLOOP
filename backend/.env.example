# Copy to backend/.env. Run Maven from backend/.
DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Configure these with your email provider's SMTP settings to enable password reset.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_STARTTLS=true
